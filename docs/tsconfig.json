{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@dhaakon/ui": ["../src/index.ts"],
      "@dhaakon/ui/site": ["../src/site/index.ts"],
      "@dhaakon/ui/app": ["../src/app/index.ts"],
      "@dhaakon/ui/tokens": ["../src/tokens.ts"],

      // The kit source lives outside this project, so without these it would
      // resolve React from ../node_modules and collide with the copy here.
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-aria-components": ["./node_modules/react-aria-components"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
