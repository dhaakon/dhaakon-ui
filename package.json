{
  "name": "@dhaakon/ui",
  "version": "0.5.2",
  "description": "Dhaakon UI — the design system and React component library for the dhaakon-network. Built from dhaakon.com and IBM Plex.",
  "type": "module",
  "license": "MIT",
  "author": "dhaakon (https://dhaakon.com)",
  "homepage": "https://ui.dhaakon.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaakon/dhaakon-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dhaakon/dhaakon-ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "react-aria",
    "accessibility",
    "ibm-plex",
    "ui-kit",
    "tokens",
    "dhaakon"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "AUDIT.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "VERIFICATION.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/dhaakon-ui.css",
    "./theme.css": "./dist/theme.css",
    "./site": {
      "types": "./dist/site.d.ts",
      "import": "./dist/site.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./fonts/*": "./dist/fonts/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static && node scripts/build-notices.mjs storybook",
    "build": "tsc -p tsconfig.build.json && vite build -c vite.lib.config.ts && node scripts/build-css.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "check:peers": "node scripts/check-peers.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "clsx": "^2.1.1",
    "react-aria": "3.52.0",
    "react-aria-components": "1.21.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "jsdom": "^29.0.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
